%{
#include <stdio.h>
#include "util.h"
#include "errormsg.h"

int yylex(void); /* function prototype */

void yyerror(char *s)
{
 EM_error(EM_tokPos, "%s", s);
}
%}


%union {
	int pos;
	int ival;
	string sval;
	}

%token <sval> ID STRING
%token <ival> INT

%token
  COMMA COLON SEMICOLON LPAREN RPAREN LBRACK RBRACK
  LBRACE RBRACE DOT
  PLUS MINUS TIMES DIVIDE EQ NEQ LT LE GT GE
  AND OR ASSIGN
  ARRAY IF THEN ELSE WHILE FOR TO DO LET IN END OF
  BREAK NIL
  FUNCTION VAR TYPE

%start program

%%

/* This is a skeleton grammar file, meant to illustrate what kind of
 * declarations are necessary above the %% mark.  Students are expected
 *  to replace the two dummy productions below with an actual grammar.
 */

program: exp ;

logical_op : comparison_op logical_op_aux ;

logical_op_aux  :   OR comparison_op logical_op_aux
                |   AND comparison_op logical_op_aux
                |
                ;

comparison_op : addition_op comparison_op_aux ;

comparison_op_aux   :   NEQ addition_op comparison_op_aux
                    |   EQ addition_op comparison_op_aux
                    |   LT addition_op comparison_op_aux
                    |   LE addition_op comparison_op_aux
                    |   GT addition_op comparison_op_aux
                    |   GE addition_op comparison_op_aux
                    |
                    ;

addition_op : multiply_op addition_op_aux ;

addition_op_aux :   PLUS multiply_op addition_op_aux
                |   MINUS multiply_op addition_op_aux
                |
                ;

multiply_op : unary_op multiply_op_aux ;

multiply_op_aux :   TIMES unary_op multiply_op_aux
                |   DIVIDE unary_op multiply_op_aux
                |
                ;

unary_op:   MINUS singleton_op
        |   singleton_op
        ;

singleton_op:   STRING
            |   INT
            |   NIL
            |   lvalue
            |   ID LPAREN opt_exp_list RPAREN
            ;

exp :   lvalue ASSIGN exp
    |   logical_op
    |   LPAREN exp_seq RPAREN
    |   ID LBRACE field_list RBRACE
    |   built_in_types LBRACE field_list RBRACE
    |   ID LBRACK exp RBRACK OF exp
    |   built_in_types LBRACK exp RBRACK OF exp
    |   if_then
    |   if_then_else
    |   WHILE exp DO exp
    |   FOR ID ASSIGN exp TO exp DO exp
    |   BREAK
    |   LET declaration_list IN exp_seq END
    ;

if_then : IF exp THEN exp ;
if_then_else : IF exp THEN exp ELSE exp ;


opt_exp_list: exp_list
            |
            ;

exp_list:   exp
        |   exp_list COMMA exp
        ;

exp_seq :   exp
        |   exp_seq SEMICOLON exp
        ;

field_list  :   ID EQ exp
            |   field_list COMMA ID EQ exp
            ;

lvalue : ID lvalue_aux ;

lvalue_aux  :   DOT ID lvalue_aux
            |   LBRACK exp RBRACK lvalue_aux
            |
            ;

declaration_list:   declaration
                |   declaration_list declaration
                ;

declaration :   type_declaration
            |   variable_declaration
            |   func_declaration
            ;

type_declaration:   TYPE ID EQ type
                |   TYPE built_in_types EQ type ;

type:   ID
    |   built_in_types
    |   LBRACE type_fields RBRACE
    |   ARRAY OF ID
    |   ARRAY OF built_in_types
    ;

type_fields :   type_field
            |   type_fields COMMA type_field
            ;

type_field  :   ID COLON ID
            |   ID COLON built_in_types ;

variable_declaration:   VAR ID ASSIGN exp
                    |   VAR ID COLON ID ASSIGN exp
                    |   VAR ID COLON built_in_types ASSIGN exp
                    ;

func_declaration:   FUNCTION ID LPAREN type_fields RPAREN EQ exp
                |   FUNCTION ID LPAREN type_fields RPAREN COLON ID EQ exp
                |   FUNCTION ID LPAREN type_fields RPAREN COLON built_in_types EQ exp
                ;

built_in_types : INT | STRING ;
